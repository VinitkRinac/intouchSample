.pt:hover img{transform:scale(1.04)}
.ceo blockquote{margin:0;font:400 clamp(26px,3.5vw,44px)/1.25 var(--e);letter-spacing:-.02em}
.ceo blockquote::before{content:"“";display:block;font-size:96px;line-height:.6;color:var(--blue);margin-bottom:10px}
.ceo cite{display:block;font:600 18px var(--s);font-style:normal;margin:34px 0 18px}.ceo cite small{display:block;font-weight:400;color:var(--mut);font-size:15px}
.ceo .sg{color:var(--mut);font-size:16px}
@media(max-width:820px){.ceo{grid-template-columns:1fr}.pt{max-width:320px}}
.gm{border:1px solid var(--line);border-radius:32px;padding:clamp(24px,5vw,56px);background:var(--bg);margin-top:56px;max-width:820px}
.trk{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px}.trk span{padding:6px 18px;border-radius:99px;border:1px solid var(--line);font-size:14px;color:var(--mut);transition:.4s}
