.quiz{max-width:720px;margin-top:60px}
.quiz h3{font-size:clamp(26px,3.6vw,40px);margin:18px 0 30px}
.quiz .top{display:flex;justify-content:space-between;color:var(--mut);font-size:15px}
.bar{height:2px;background:var(--line);margin-top:10px}.bar i{display:block;height:100%;background:var(--blue);transition:width .5s}
.op{display:grid;gap:10px}
.op button{all:unset;box-sizing:border-box;cursor:pointer;border:1px solid var(--line);border-radius:18px;padding:16px 22px;background:var(--bg);transition:.25s}
.op button:hover:not([disabled]){border-color:var(--blue);transform:translateX(6px)}
.op button.ok{background:#1f9d62;color:#fff;border-color:#1f9d62}.op button.no{background:#d64545;color:#fff;border-color:#d64545}
.nx{all:unset;cursor:pointer;margin-top:24px;color:var(--blue);font-weight:600;border-bottom:1.5px solid var(--blue)}
.nx[hidden]{display:none}
/* events */
.ev{border-top:1px solid var(--line)}
.ev:last-child{border-bottom:1px solid var(--line)}
.ev summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:170px 1fr 28px;gap:20px;align-items:baseline;padding:34px 0}
.ev summary::-webkit-details-marker{display:none}
.ev time{color:var(--mut)}.ev h3{font-size:clamp(24px,3.2vw,38px)}
.ev h3 small{display:block;font:400 15px var(--s);color:var(--mut);letter-spacing:0;margin-top:4px}
.ev summary::after{content:"+";font:300 30px var(--s);color:var(--blue);transition:transform .3s}
.ev[open] summary::after{transform:rotate(45deg)}
.ev p{margin:0 0 34px 190px;color:var(--mut)}
@media(max-width:700px){.ev summary{grid-template-columns:1fr 28px}.ev time{grid-column:1/-1}.ev p{margin-left:0}}
