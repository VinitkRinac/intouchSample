.hero{position:relative;min-height:100vh;margin-top:-64px;display:flex;align-items:center;overflow:hidden;padding:120px var(--pad) 80px}
.hero canvas{position:absolute;inset:0;width:100%;height:100%}
.hero::after{content:"";position:absolute;inset:0;pointer-events:none;opacity:var(--glow);transition:opacity .8s;background:radial-gradient(520px 520px at calc(100% - 96px) 0,rgba(255,206,107,.28),transparent 70%)}
