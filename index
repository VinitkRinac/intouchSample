.ph{aspect-ratio:4/5;border-radius:32px;background:linear-gradient(150deg,#d8ecf9,#8fc7ea 60%,#0079c1);display:flex;align-items:flex-end;padding:20px;color:#08304f;font-size:14px}
.ph span{background:rgba(255,255,255,.65);padding:4px 12px;border-radius:99px}
/* projects */
.rail{display:flex;gap:22px;overflow-x:auto;scroll-snap-type:x mandatory;padding:60px var(--pad) 20px;margin:0 calc(-1*var(--pad));scrollbar-width:thin}
.card{flex:0 0 min(380px,82vw);scroll-snap-align:start;border:1px solid var(--line);border-radius:30px;background:var(--bg);overflow:hidden;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
