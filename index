.ac h3{font-size:26px;font-weight:600;letter-spacing:-.02em}
.ac .bd{opacity:0;transform:translateY(14px);transition:.5s .15s;max-width:36ch;font-size:16px}
.ac button[aria-expanded=true] .bd{opacity:1;transform:none}
.ac .bd i{display:inline-block;margin:10px 6px 0 0;border:1px solid rgba(255,255,255,.5);border-radius:99px;padding:2px 12px;font-style:normal;font-size:14px}
.ac .ix{font:300 14px var(--s);opacity:.6}
@media(max-width:820px){.ac{flex-direction:column;height:auto}.ac button{flex:none;min-height:96px}.ac button[aria-expanded=true]{min-height:300px}.ac .bd{display:none}.ac button[aria-expanded=true] .bd{display:block}}
.say{margin-top:80px;font:400 clamp(24px,3.4vw,40px)/1.25 var(--e);max-width:26ch}
.say small{display:block;font:400 16px var(--s);color:var(--mut);margin-top:16px}
/* accomplishment */
.two{display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(30px,6vw,90px);align-items:center}
