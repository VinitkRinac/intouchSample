.cur{position:fixed;left:0;top:0;width:260px;height:260px;margin:-130px 0 0 -130px;border-radius:50%;pointer-events:none;z-index:1;background:radial-gradient(circle,rgba(0,121,193,.13),transparent 65%);opacity:0;transition:opacity .4s}
