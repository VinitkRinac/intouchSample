.fr{display:flex;align-items:center;gap:14px;font-size:15px;color:var(--mut)}.fr .bar{flex:1;height:8px;border-radius:9px;overflow:hidden;margin:0}.fr .bar i{background:var(--fc,#1f9d62);transition:width .5s,background .5s}
.fb{min-height:3em;margin:18px 0 0;color:var(--mut);font-size:15px}
.shake{animation:sk .4s}@keyframes sk{25%{transform:translateX(-9px)}75%{transform:translateX(9px)}}
.sh{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}.sh button{all:unset;cursor:pointer;border:1px solid var(--line);border-radius:99px;padding:8px 18px;font-size:15px;transition:.25s}.sh button:hover{border-color:var(--blue);color:var(--blue)}
.sh .p,.sh .p:hover{background:var(--blue);border-color:var(--blue);color:#fff}.sh small{flex-basis:100%;color:var(--mut)}
.card{will-change:transform}.rail{cursor:grab}.rail.dg{cursor:grabbing;scroll-snap-type:none}
.adv{display:flex;gap:24px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-top:28px;max-width:820px;padding:clamp(22px,4vw,40px);border-radius:28px;background:#0079c1;color:#fff}
.adv h3{font-size:clamp(22px,3vw,30px);font-weight:600;margin-bottom:6px}.adv p{margin:0;max-width:44ch;opacity:.92}
.adv button{all:unset;cursor:pointer;background:#fff;color:#0b1220;border-radius:99px;padding:14px 28px;font-weight:700;transition:transform .25s}.adv button:hover:not([disabled]){transform:translateY(-3px)}.adv button[disabled]{opacity:.65;cursor:default}
#mod{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.82);display:flex;flex-direction:column;align-items:center;padding:calc(12px + env(safe-area-inset-top,0px)) 12px calc(12px + env(safe-area-inset-bottom,0px))}#mod[hidden]{display:none}
#mod .bar2{display:flex;gap:12px;width:min(520px,100%);justify-content:flex-end;padding-bottom:8px}#mod .bar2 a,#mod .bar2 button{all:unset;cursor:pointer;color:#fff;border:1px solid rgba(255,255,255,.6);border-radius:99px;padding:8px 18px;font-size:15px}
#mod iframe{flex:1;width:min(520px,100%);border:0;border-radius:16px;background:#0b2a3f}
@media(prefers-reduced-motion:reduce){.rv{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto!important}.hero h1 span{opacity:1;transform:none}}
</style>
