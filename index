<footer><div class="wrap"><div><b>RINAC</b><p>Pioneer in cold chain and modular construction technology.</p></div><p><a href="https://www.rinac.com">www.rinac.com</a><br>InTouch · Rinac India Limited · August 2026</p></div></footer>

<script>
const $=s=>document.querySelector(s),R=document.documentElement;
const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
// headline
$('#h1').innerHTML='Engineering tomorrow’s <b>infrastructure</b>, today.'.split(' ').map((w,i)=>'<span style="--i:'+i+'">'+w+'</span>').join(' ');
// theme
function toggle(){R.dataset.theme=R.dataset.theme==='dark'?'light':'dark'}
// pendulum
const g=$('#bg');let th=.55,om=0,drag=false,moved=0;
function frame(){if(!drag){om+=-.012*Math.sin(th);om*=.992;th+=om}
 g.style.transform='rotate('+(th*57.2958).toFixed(2)+'deg)';requestAnimationFrame(frame)}
frame();
g.addEventListener('pointerdown',e=>{drag=true;moved=0;g.setPointerCapture(e.pointerId)});
g.addEventListener('pointermove',e=>{if(!drag)return;const r=$('#pend').getBoundingClientRect(),px=r.left+r.width/2;
 th=Math.max(-1.15,Math.min(1.15,-Math.atan2(e.clientX-px,Math.max(e.clientY,40))));om=0;moved=Math.max(moved,Math.abs(th))});
g.addEventListener('pointerup',()=>{drag=false;if(moved>.4||moved<.05)toggle()});
g.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();om=.08;toggle()}});
setTimeout(()=>{om=0},0);
// hero particles
const cv=$('#cv'),cx=cv.getContext('2d'),hero=$('.hero');let W,H,P=[],m={x:-999,y:-999},dpr=Math.min(devicePixelRatio||1,2);
function size(){W=hero.clientWidth;H=hero.clientHeight;cv.width=W*dpr;cv.height=H*dpr;cx.setTransform(dpr,0,0,dpr,0,0);
 const n=Math.min(130,Math.round(W*H/11000));P=Array.from({length:n},()=>({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.3,vy:Math.random()*.4+.1,r:Math.random()*2+.8}))}
size();addEventListener('resize',size);
hero.addEventListener('pointermove',e=>{const r=hero.getBoundingClientRect();m.x=e.clientX-r.left;m.y=e.clientY-r.top;const c=$('#cur');c.style.opacity=1;c.style.transform='translate('+e.clientX+'px,'+e.clientY+'px)'});
hero.addEventListener('pointerleave',()=>{m.x=m.y=-999;$('#cur').style.opacity=0});
function tick(){cx.clearRect(0,0,W,H);const col=getComputedStyle(R).getPropertyValue('--blue').trim();cx.fillStyle=col;cx.strokeStyle=col;
 for(const p of P){const dx=p.x-m.x,dy=p.y-m.y,d=Math.hypot(dx,dy);
  if(d<150){const f=(150-d)/150;p.vx+=dx/d*f*.9;p.vy+=dy/d*f*.9}
  p.vx*=.96;p.vy=p.vy*.96+.012;p.x+=p.vx+Math.sin(p.y/60)*.15;p.y+=p.vy;
  if(p.y>H+10){p.y=-10;p.x=Math.random()*W}if(p.x<-10)p.x=W+10;if(p.x>W+10)p.x=-10;
  cx.globalAlpha=.55;cx.beginPath();cx.arc(p.x,p.y,p.r,0,6.283);cx.fill();
  if(d<170){cx.globalAlpha=(170-d)/170*.5;cx.lineWidth=1;cx.beginPath();cx.moveTo(p.x,p.y);cx.lineTo(m.x,m.y);cx.stroke()}}
 requestAnimationFrame(tick)}
if(!reduce)tick();
// counters
const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;io.unobserve(e.target);const el=e.target,n=+el.dataset.n,s=el.dataset.s;let st=null;
 const step=ts=>{st??=ts;const p=Math.min((ts-st)/1400,1);el.textContent=Math.round(n*(1-Math.pow(1-p,3))).toLocaleString('en-IN')+(p===1?s:'');if(p<1)requestAnimationFrame(step)};requestAnimationFrame(step)}),{threshold:.6});
document.querySelectorAll('[data-n]').forEach(e=>io.observe(e));
// panels
const A=[['PUF','Superior thermal insulation','Best where holding temperature at low running cost matters most.',['Cold storage','Food processing','Logistics']],
['PIR','Enhanced fire performance','Strong insulation with better fire behaviour.',['Cleanrooms','Pharma']],
['FM approved PUR','Certified fire safety','For applications that need internationally certified fire safety.',['Pharma','Data centres']],
['R-Wool stonewool','Non-combustible','New this year, for projects where fire resistance is paramount.',['Data centres','Semiconductor','Battery and EV','Defence']]];
const ac=$('#ac');A.forEach((a,i)=>{const b=document.createElement('button');b.type='button';b.setAttribute('aria-expanded',i===0);
 b.innerHTML='<span class="ix">'+a[0]+'</span><div><h3>'+a[1]+'</h3><div class="bd"><p>'+a[2]+'</p>'+a[3].map(u=>'<i>'+u+'</i>').join('')+'</div></div>';
 b.onclick=()=>[...ac.children].forEach((x,j)=>x.setAttribute('aria-expanded',j===i));ac.append(b)});
// quiz
const Q=[['What does HPCC, Rinac’s prefab construction technology, stand for?',['High Performance Composite Construction','High Pressure Cold Chain','Hybrid Panel Cladding Concept'],0],
['What is the standard temperature for frozen storage?',['−4°C','0°C','−18°C'],2],
['Which natural refrigerant has the lowest global warming potential?',['R-134a','CO2 (R-744)','R-22'],1],
['Which food safety system is standard for cold storage facilities?',['HACCP','ISO 9001','LEED'],0],
['What term describes rapidly removing field heat from produce before storage?',['Curing','Ripening','Pre-cooling'],2]];
let qi=0,sc=0;const qz=$('#qz');
function ask(){const [t,o,a]=Q[qi];qz.innerHTML='<div class="top"><span>Question '+(qi+1)+' of '+Q.length+'</span><span>Score '+sc+'</span></div><div class="bar"><i style="width:'+qi/Q.length*100+'%"></i></div><h3>'+t+'</h3><div class="op"></div><button class="nx" hidden type="button">'+(qi<Q.length-1?'Next question':'See my score')+'</button>';
 const w=qz.querySelector('.op'),nx=qz.querySelector('.nx');
 o.forEach((x,i)=>{const b=document.createElement('button');b.textContent=x;b.onclick=()=>{w.querySelectorAll('button').forEach((y,j)=>{y.disabled=true;if(j===a)y.classList.add('ok')});if(i===a)sc++;else b.classList.add('no');nx.hidden=false;nx.focus()};w.append(b)});
 nx.onclick=()=>{qi++;qi<Q.length?ask():done()}}
function done(){qz.innerHTML='<h3>You scored '+sc+' out of '+Q.length+'.</h3>'+shareBox('I scored '+sc+'/'+Q.length+' on the Rinac InTouch cold chain quiz. Can you beat me? #ColdChain #Rinac #InTouch')+'<button class="nx" type="button">Play again</button>';qz.querySelector('.nx').onclick=()=>{qi=0;sc=0;ask()}}
ask();
// share
function shareBox(t){return '<div class="sh" data-text="'+t.replace(/"/g,'&quot;')+'"><button class="p" data-k="n" type="button">Share your progress</button><button data-k="wa" type="button">WhatsApp</button><button data-k="x" type="button">X</button><button data-k="li" type="button">LinkedIn</button><small>#KeepItFresh #ColdChain #Rinac #InTouch</small></div>'}
document.addEventListener('click',e=>{const b=e.target.closest('[data-k]');if(!b)return;const t=b.parentElement.dataset.text,url=location.href.split('#')[0],k=b.dataset.k,x=encodeURIComponent(t);
 if(k==='wa')open('https://wa.me/?text='+encodeURIComponent(t+' '+url),'_blank');
 else if(k==='x')open('https://twitter.com/intent/tweet?text='+x+'&url='+encodeURIComponent(url),'_blank');
 else if(k==='li')open('https://www.linkedin.com/sharing/share-offsite/?url='+encodeURIComponent(url),'_blank');
 else if(navigator.share)navigator.share({text:t,url}).catch(()=>{});
 else if(navigator.clipboard)navigator.clipboard.writeText(t+' '+url).then(()=>{b.textContent='Copied to clipboard'}).catch(()=>{});});
// game
const ST=['Farm','Storage','Transport','Retail'];
const S=[['Farm','Mangoes were picked at 34°C. What comes first?',['Pack them straight onto trucks','Pre-cool to remove field heat','Leave them in the sun to ripen'],1,'Pre-cooling removes field heat before it spoils the crop. Rinac builds it into its packhouse solutions.'],
['Farm','The fruit reaches the packhouse. What next?',['Stack it in an open shed','Wash it and leave it wet outside','Sort, grade and heat-treat it for export'],2,'Grading and hot water or vapour heat treatment meet export standards. FruitoLine covers this.'],
['Storage','Pallets are going into the cold store. How do you keep warm air out?',['Dock shelters and sectional doors','Prop the doors open','Load only at noon'],0,'Sealed docking keeps temperature loss close to zero while loading.'],
['Storage','Dairy and mango pulp need different temperatures. What do you build?',['One room for everything','Switch cooling off at night','Separate positive and negative rooms'],2,'Multi-temperature rooms store each product at its own setting.'],
['Transport','Time to ship to the port. Which vehicle?',['A refrigerated truck at set temperature','An open truck','A closed van with no cooling'],0,'A temperature-controlled vehicle keeps the chain unbroken on the road.'],
['Transport','The truck waits hours at the port gate. What now?',['Open the doors for air','Switch off the refrigeration','Keep it running and watch the temperature'],2,'Continuous cooling and monitoring protect the load while it waits.'],
['Retail','Stock arrives at the store. Where does it go first?',['A warm stockroom','A display cold room','An ambient shelf'],1,'Straight into cold display, like Rinac’s Sapphire display cum cold room.'],
['Retail','How do you keep the display efficient all day?',['Take the doors off','Prop a door open for shoppers','Keep the glass doors closed'],2,'Closed glass doors keep cooling efficient while products stay visible.']];
const gm=$('#gm');let gi=-1,fr=100;
const fc=()=>fr>66?'#1f9d62':fr>33?'#e8a317':'#d64545';
const fbar=()=>'<div class="fr"><span>Freshness</span><div class="bar"><i style="width:'+fr+'%;--fc:'+fc()+'"></i></div><b>'+fr+'</b></div>';
function gRender(){
 if(gi<0){gm.innerHTML='<h3 style="font-size:clamp(24px,3vw,34px)">From the farm gate to the shop shelf.</h3><p style="margin:16px 0 28px;color:var(--mut)">Eight decisions. You start with 100 freshness and lose 15 for every wrong choice.</p><button class="nx" type="button">Start the journey</button>';gm.querySelector('.nx').onclick=()=>{gi=0;fr=100;gRender()};return}
 if(gi>=S.length){const g=fr>=90?'Cold chain champion':fr>=60?'Fresh enough to export':'A little wilted. Try again';gm.innerHTML=fbar()+'<h3 style="font-size:clamp(28px,4vw,48px);margin:26px 0 10px">'+g+'</h3><p style="color:var(--mut)">You delivered at '+fr+' out of 100 freshness. From pre-cooling to retail display, Rinac builds every link in this chain.</p>'+shareBox('I kept it '+fr+'% fresh from farm to retail in the Rinac InTouch cold chain game. Can you beat me?')+'<button class="nx" type="button">Play again</button>';gm.querySelector('.nx').onclick=()=>{gi=-1;gRender()};return}
 const [st,q,o,a,why]=S[gi],si=ST.indexOf(st);
 gm.innerHTML='<div class="trk">'+ST.map((s,j)=>'<span class="'+(j===si?'on':j<si?'dn':'')+'">'+s+'</span>').join('')+'</div>'+fbar()+'<h3 style="font-size:clamp(22px,3vw,32px);margin:28px 0 22px">'+q+'</h3><div class="op"></div><p class="fb"></p><button class="nx" hidden type="button">'+(gi<S.length-1?'Next step':'See result')+'</button>';
 const w=gm.querySelector('.op'),nx=gm.querySelector('.nx'),fb=gm.querySelector('.fb');
 o.forEach((x,i)=>{const b=document.createElement('button');b.textContent=x;b.onclick=()=>{
  if(i===a){w.querySelectorAll('button').forEach((y,j)=>{y.disabled=true;if(j===a)y.classList.add('ok')});fb.textContent=why;nx.hidden=false;nx.focus()}
  else{fr=Math.max(0,fr-15);b.classList.add('no');b.disabled=true;const bi=gm.querySelector('.fr i');bi.style.width=fr+'%';bi.style.setProperty('--fc',fc());gm.querySelector('.fr b').textContent=fr;fb.textContent='Not quite. That cost 15 freshness. Try another.';gm.classList.remove('shake');void gm.offsetWidth;gm.classList.add('shake')}};w.append(b)});
 nx.onclick=()=>{gi++;gRender()}}
gRender();
// full game link: set GAME_URL to the address where you host the Phaser game folder
const GAME_URL='';
const ab=$('#advBtn'),md=$('#mod');
if(!GAME_URL){ab.textContent='Full adventure coming soon';ab.disabled=true}
ab.onclick=()=>{if(!GAME_URL)return;$('#mf').src=GAME_URL;$('#mo').href=GAME_URL;md.hidden=false};
const closeMod=()=>{md.hidden=true;$('#mf').src='about:blank'};
$('#mc').onclick=closeMod;addEventListener('keydown',e=>{if(e.key==='Escape'&&!md.hidden)closeMod()});
// page interactions
const sp=$('#sp');addEventListener('scroll',()=>{sp.style.width=scrollY/Math.max(1,R.scrollHeight-innerHeight)*100+'%'},{passive:true});
const nl=[...document.querySelectorAll('nav a')];const so=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)nl.forEach(a=>a.classList.toggle('on',a.getAttribute('href')==='#'+e.target.id))}),{rootMargin:'-45% 0px -50% 0px'});document.querySelectorAll('section[id]').forEach(s=>so.observe(s));
const ro=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');ro.unobserve(e.target)}}),{threshold:.15});
document.querySelectorAll('section h2,.ceo,.gm,.ev').forEach(e=>{e.classList.add('rv');ro.observe(e)});
document.querySelectorAll('.card').forEach(c=>{c.addEventListener('pointermove',e=>{if(e.pointerType!=='mouse')return;const r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;c.style.transform='perspective(800px) rotateY('+x*9+'deg) rotateX('+-y*9+'deg) translateY(-6px)'});c.addEventListener('pointerleave',()=>c.style.transform='')});
const rl=document.querySelector('.rail');let dx=0,ds=0,dd=false;
rl.addEventListener('pointerdown',e=>{if(e.pointerType!=='mouse')return;dd=true;dx=e.clientX;ds=rl.scrollLeft;rl.classList.add('dg')});
addEventListener('pointermove',e=>{if(dd)rl.scrollLeft=ds-(e.clientX-dx)});addEventListener('pointerup',()=>{dd=false;rl.classList.remove('dg')});
const ct=document.querySelector('.cta');ct.addEventListener('pointermove',e=>{const r=ct.getBoundingClientRect();ct.style.transform='translate('+(e.clientX-r.left-r.width/2)*.18+'px,'+(e.clientY-r.top-r.height/2)*.3+'px)'});ct.addEventListener('pointerleave',()=>ct.style.transform='');
</script>
