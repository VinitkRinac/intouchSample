#pend{position:fixed;top:0;right:clamp(22px,5vw,80px);z-index:40;width:80px;height:230px;overflow:visible;touch-action:none}
#pend .g{transform-origin:40px 0;cursor:grab}
#pend .g:active{cursor:grabbing}
#pend,#pend *{-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none}
#pend .g,#pend .g:focus,#pend .g:focus-visible,#pend:focus{outline:none!important}
#pend .g:focus-visible .bulb{stroke:var(--blue);stroke-width:4}
#pend .bulb{fill:var(--bg);stroke:var(--ink);stroke-width:2;transition:fill .5s,stroke .5s}
:root[data-theme="dark"] #pend .bulb{fill:#ffd36b;stroke:#ffd36b;filter:drop-shadow(0 0 18px rgba(255,206,107,.9))}
#pend .fil{stroke:var(--mut);stroke-width:1.5;fill:none;transition:stroke .5s}
:root[data-theme="dark"] #pend .fil{stroke:#a55d00}
#pend .rope,#pend .cap{stroke:var(--ink);fill:var(--ink)}
/* leadership */
.q{font:400 clamp(28px,4.4vw,56px)/1.18 var(--e);max-width:24ch;letter-spacing:-.02em}
.q small{display:block;font:400 16px var(--s);color:var(--mut);margin-top:28px;letter-spacing:0}
