.hero h1{font-size:clamp(48px,9.6vw,150px);max-width:10ch}
.hero h1 span{display:inline-block;opacity:0;transform:translateY(.4em);animation:up .9s cubic-bezier(.2,.8,.2,1) forwards;animation-delay:calc(var(--i)*110ms + 200ms)}
