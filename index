.card .im{height:220px;background:linear-gradient(135deg,#cfe8f7,#0079c1);display:flex;align-items:flex-end;padding:16px;font-size:14px;color:#08304f}
.card:nth-child(2) .im{background:linear-gradient(135deg,#dff0ff,#3a5f9e)}
.card:nth-child(3) .im{background:linear-gradient(135deg,#ffe3cf,#f58a3c)}
.card:nth-child(4) .im{background:linear-gradient(135deg,#d6f2e5,#2f9d6d)}
.card .im span{background:rgba(255,255,255,.7);padding:3px 10px;border-radius:99px}
.card div.t{padding:26px}.card h3{font-size:24px;font-weight:600;margin-bottom:4px}
.card .lo{color:var(--blue);font-size:15px;font-weight:600;margin-bottom:12px}
