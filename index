.soft{background:var(--soft);transition:background .6s}
.ac{display:flex;gap:14px;margin-top:70px;height:430px}
.ac button{all:unset;box-sizing:border-box;flex:1;min-width:0;background:var(--bg);border:1px solid var(--line);border-radius:26px;padding:28px;cursor:pointer;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;transition:flex .7s cubic-bezier(.2,.8,.2,1),background .4s,border-color .4s}
